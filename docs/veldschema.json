{
  "schema_versie": "1.2",
  "toelichting": "Gedeeld veldschema voor (1) de beloningsassistent in ChatGPT die formulieren en regelingen omzet en (2) de beloningsgenerator. Veldnamen nooit wijzigen zonder schema_versie op te hogen.",
  "velden": {
    "meta": {
      "schema_versie": "string, altijd '1.2'",
      "bron_type": "enum: 'sugb' | 'gelijkwaardige_beloning_overig' | 'inlenersbeloning_oud' | 'beloningsregister' | 'onbekend'",
      "bron_naam": "string | null — naam van tool of uitlener waar het formulier vandaan komt, bijv. 'wijzerbelonen.nl'",
      "bron_datum": "string YYYY-MM-DD | null — datum waarop het bronformulier is ingevuld of ondertekend",
      "peildatum": "string YYYY-MM-DD | null — vult de intercedent in de generator in",
      "documenten": "array van strings: namen van alle aangeleverde documenten"
    },
    "klant": {
      "bedrijfsnaam": "string | null",
      "kvk_nummer": "string | null — alleen cijfers",
      "vestigingsplaats": "string | null",
      "contactpersoon_naam": "string | null",
      "contactpersoon_email": "string | null"
    },
    "cao": {
      "van_toepassing": "boolean | null",
      "naam": "string | null — zoals genoemd in het bronformulier",
      "looptijd_van": "string YYYY-MM-DD | null",
      "looptijd_tot": "string YYYY-MM-DD | null",
      "eigen_regeling_naast_cao": "boolean | null — true als de klant naast de cao eigen regelingen heeft"
    },
    "cao_keuzes": {
      "uren_per_week": "number | null",
      "loontabel": "enum: 'maand' | '4-weken' | null",
      "dagvenster": "string | null — bijv. '06.00-18.00'",
      "ploegendienst": "boolean | null",
      "overwerk_inbegrepen_in_salaris": "boolean | null"
    },
    "functies": [
      {
        "functienaam": "string",
        "schaal_of_functiegroep": "string | null",
        "opmerking": "string | null"
      }
    ],
    "uitzonderingen": [
      {
        "subkop": "string: exact één kop uit caoloon_koppen[].kop (niet 'Vakantie')",
        "afspraak": "string: wat de opdrachtgever afwijkend of extra geeft, max. 25 woorden",
        "voorwaarden": "string | null: wanneer de afspraak geldt; nooit weglaten als een bron voorwaarden noemt",
        "bronnen": [
          {
            "document": "string",
            "vindplaats": "string | null, bijv. 'p. 13' of 'art. 6.2'"
          }
        ],
        "toepassing": "enum: 'structureel' | 'voorwaardelijk'; optioneel, generator vult standaard per kop in"
      }
    ],
    "conform_cao": "array van strings — subkoppen waarvan de bron gelijk is aan de Caoloon-uitdraai (alleen voor audit, komt niet als afwijking in het document)",
    "te_controleren": [
      {
        "subkop": "string",
        "signaal": "enum: 'mogelijk_onder_cao' | 'tegenstrijdig' | 'onduidelijk' | 'bijlage_ontbreekt' | 'voorwaarde_toetsen'",
        "waarde_in_bron": "string",
        "waarde_cao": "string | null",
        "reden": "string, max. 20 woorden",
        "bronnen": [
          {
            "document": "string",
            "vindplaats": "string | null",
            "tekst": "string: wat déze bron zegt, max. 30 woorden"
          }
        ],
        "toepassing": "enum: 'structureel' | 'voorwaardelijk'; optioneel"
      }
    ],
    "ontbrekend": "array van strings — veldpaden die niet in de bron stonden, bijv. 'klant.kvk_nummer'"
  },
